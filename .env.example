# Local Development must use an isolated Supabase project, never Production.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=development
# Set only for an approved tagged release, e.g. 0.6.0-rc.1.
VITE_APP_VERSION=

# Override for an independently hosted staging/development site if needed.
VITE_BASE_PATH=/northgate
